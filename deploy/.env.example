# Copier en .env puis adapter :  cp .env.example .env

# IP sur laquelle publier les ports (127.0.0.1 = local uniquement, IP Tailscale pour le réseau privé)
BIND_IP=127.0.0.1
FRONTEND_PORT=8280
KEYCLOAK_PORT=8281
PROMETHEUS_PORT=9095

# Tunnel local (cloudflared...) vers http://localhost:${FRONTEND_PORT} : décommenter
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml

# Images (publiées par GitHub Actions sur GHCR)
REGISTRY=ghcr.io/thesphynxoid
TAG=latest

# Base de données (une instance, une base par service)
POSTGRES_USER=espritmarket
POSTGRES_PASSWORD=change-me

# Keycloak (admin du master realm, utilisé aussi par le service USER pour créer les comptes)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=espritmarket
RABBITMQ_PASSWORD=change-me

# Emails du service Notification — Mailtrap (prioritaire) ou SMTP ; sinon les emails sont seulement loggés.
# Mailtrap : Settings > API Tokens (token avec accès Sandbox / Sending).
#  - Test : MAILTRAP_INBOX_ID = id de la boîte Sandbox (dans l'URL : mailtrap.io/inboxes/<ID>/messages)
#    -> tous les emails arrivent dans cette boîte, quel que soit le destinataire.
#  - Envoi réel : laisser MAILTRAP_INBOX_ID vide et MAILTRAP_FROM sur un domaine vérifié dans Mailtrap.
# Appliquer : docker compose up -d notification   (vérifier : docker compose logs notification | grep 'email mode')
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM=
MAILTRAP_FROM_NAME=EspritMarket

# SMTP (optionnel, service Notification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse expéditeur (doit être une adresse email valide)
SMTP_FROM=notifications@espritmarket.local
# STARTTLS (true pour Mailtrap SMTP sur le port 2525 / 587)
SMTP_TLS=true
