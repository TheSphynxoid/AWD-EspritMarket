# Copier en .env puis adapter :  cp .env.example .env

# IP sur laquelle publier les ports (127.0.0.1 = local uniquement, IP Tailscale pour le réseau privé)
BIND_IP=127.0.0.1
FRONTEND_PORT=8280
KEYCLOAK_PORT=8281
PROMETHEUS_PORT=9095

# Images (publiées par GitHub Actions sur GHCR)
REGISTRY=ghcr.io/thesphynxoid
TAG=latest

# Base de données (une instance, une base par service)
POSTGRES_USER=espritmarket
POSTGRES_PASSWORD=change-me

# Keycloak (admin du master realm, utilisé aussi par le service USER pour créer les comptes)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=espritmarket
RABBITMQ_PASSWORD=change-me

# SMTP (optionnel, service Notification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
