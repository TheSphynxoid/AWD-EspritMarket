@startuml architecture-physique

title <size:22>**Architecture physique (déploiement Docker) — EspritMarket**</size>

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam rectangleRoundCorner 12
skinparam packageRectangleRoundCorner 18
skinparam ArrowFontSize 12
skinparam ArrowColor #444444
skinparam nodesep 35
skinparam ranksep 55

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam node {
  BackgroundColor #FAFAFA
  BorderColor #333333
}

actor "Navigateur" as Client
cloud "Internet\n(tunnel Cloudflare,\noptionnel)" as CF #F5F5F5
rectangle "**GitHub Actions**\nimages → GHCR" as CI #F5F5F5

node "Serveur — docker compose (deploy/)" as HOST {

  rectangle "**frontend** (nginx)\nAngular + proxy /gw, /auth\n<b>publié :8280</b>" as FE #E8F5E9
  rectangle "**keycloak** 24\n<b>publié :8281</b> (admin)" as KC #FFF3E0
  rectangle "**prometheus**\n<b>publié :9095</b>" as PROM #F3E5F5

  package "réseau interne « backend » (non publié)" as NET #F7FBFF {
    rectangle "**gateway** :8088" as GW #EFEFEF
    rectangle "**discovery** (Eureka) :8761" as EU #EFEFEF

    rectangle "**srv** :8082" as SRV
    rectangle "**marketplace** :8083" as MKT
    rectangle "**delivery** :8084" as DEL
    rectangle "**event** :8085" as EVT
    rectangle "**user** :8087" as USR
    rectangle "**partnership** :8089" as PTN
    rectangle "**notification** :8090\nPython" as NOT #E3F2FD

    rectangle "**rabbitmq** :5672\nfile « notifications »\n<size:11>publiée par srv, event, marketplace,</size>\n<size:11>delivery, partnership</size>" as RMQ #E3F2FD
    database "**postgres** 16 :5432\nkeycloak, srv_db, marketplace_db,\ndelivery_db, event_db, partnership_db" as PG #FDEBD2
  }
}

rectangle "**Mailtrap**" as MAIL #F5F5F5

Client -down-> CF : HTTPS
CF -down-> FE : HTTP
FE -down-> GW : /gw/**
FE -right-> KC : /auth/**

GW -down-> SRV
GW -down-> MKT
GW -down-> DEL
GW -down-> EVT
GW -down-> USR
GW -down-> PTN
GW .left.> EU : lb://

SRV -down-> PG
MKT -down-> PG
DEL -down-> PG
EVT -down-> PG
PTN -down-> PG
KC -down-> PG

SRV -down-> RMQ
EVT -down-> RMQ
RMQ -right-> NOT : AMQP
NOT -right-> MAIL : SMTP

PROM .down.> EU : découverte des cibles\n/actuator/prometheus
CI .down.> HOST : docker compose pull

@enduml
