@startuml architecture-logique

title <size:22>**Architecture logique — EspritMarket**</size>

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam rectangleRoundCorner 12
skinparam packageRectangleRoundCorner 18
skinparam ArrowFontSize 12

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

actor "Poste client\nNavigateur" as Client

rectangle "**Frontend Angular**\nSPA\n<b>:4200</b>" as FE #E8F5E9

rectangle "**API Gateway**\nSpring Cloud Gateway\n<b>port :8088</b>" as GW #EFEFEF

rectangle "**Eureka Server**\n(annuaire des services)\n<b>:8761</b>" as EU #EFEFEF

rectangle "**Keycloak**\nOAuth2 / JWT\n<b>:8180</b>" as KC #FFF3E0

package "Microservices Spring Boot / Python" as MS #DFF2F0 {
  rectangle "**SRV**\noffres de services, réservations\n<b>port :8082</b>" as SRV
  rectangle "**marketplace**\nplace de marché\n<b>port :8083</b>" as MKT
  rectangle "**Delivery**\nlivraisons\n<b>port :8084</b>" as DEL
  rectangle "**event**\névénementiel\n<b>port :8085</b>" as EVT
  rectangle "**Patnership**\npartenariats\n<b>port :8086</b>" as PTN
  rectangle "**User**\nutilisateurs sécurisés\n<b>port :8087</b>" as USR
  rectangle "**Notification**\nPython / FastAPI\n<b>port :8090</b>" as NOT
  SRV -[hidden]right-> MKT
  MKT -[hidden]right-> DEL
  DEL -[hidden]right-> EVT
  EVT -[hidden]right-> PTN
  PTN -[hidden]right-> USR
  USR -[hidden]right-> NOT
}

package "Serveur PostgreSQL" as DBS #FDEBD2 {
  database "**awd-Delivery**\n<b>:5432</b>" as AWDDB
  database "**awd-event**\n<b>:5432</b>" as EVTDB
  database "**awd-Partnership**\n<b>:5432</b>" as PTNDB
  database "**awd-srv**\n<b>:5432</b>" as SRVDB
  database "**keycloak**\n<b>:5432</b>" as KCDB
  AWDDB -[hidden]right-> EVTDB
  EVTDB -[hidden]right-> PTNDB
  PTNDB -[hidden]right-> SRVDB
  SRVDB -[hidden]right-> KCDB
}

rectangle "**RabbitMQ**\nbroker de messages\n<b>:5672 / :15672</b>" as RMQ #E3F2FD

Client -down-> FE : HTTP
FE -down-> GW : appel HTTP

Client -[hidden]right-> EU

GW -down-> MS : appel REST
GW .up.> EU : enregistrement

SRV .up.> EU : enregistrement
MKT .up.> EU : enregistrement
DEL .up.> EU : enregistrement
EVT .up.> EU : enregistrement
PTN .up.> EU : enregistrement
USR .up.> EU : enregistrement
NOT .up.> EU : enregistrement

USR .up.> KC : OAuth2 / JWT
KC -down-> KCDB : JDBC

DEL -down-> AWDDB : JDBC
EVT -down-> EVTDB : JDBC
PTN -down-> PTNDB : JDBC
SRV -down-> SRVDB : JDBC

EVT -right-> RMQ : publication (async)
RMQ -right-> NOT : consommation (async)

NOT -down-> RMQ : fallback / publish

@enduml