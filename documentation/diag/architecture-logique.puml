@startuml architecture-logique

title <size:22>**Architecture logique — EspritMarket**</size>

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam rectangleRoundCorner 12
skinparam packageRectangleRoundCorner 18
skinparam ArrowFontSize 12
skinparam ArrowColor #444444
skinparam nodesep 40
skinparam ranksep 60

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

actor "Utilisateur\n(navigateur)" as Client

rectangle "**Frontend Angular**\nSPA" as FE #E8F5E9
rectangle "**Keycloak**\nrealm espritmarket\nOAuth2 / JWT" as KC #FFF3E0
rectangle "**API Gateway**\nSpring Cloud Gateway\nvalidation JWT, CORS, Swagger" as GW #EFEFEF
rectangle "**Eureka**\nannuaire des services" as EU #EFEFEF

package "Microservices (un domaine, une base)" as MS #DFF2F0 {
  rectangle "**SRV**\nservices, réservations" as SRV
  rectangle "**marketplace**\nboutiques, produits, panier" as MKT
  rectangle "**Delivery**\nlivraisons, livreurs" as DEL
  rectangle "**Event**\névénements, billets" as EVT
  rectangle "**Partnership**\nentreprises, offres, candidatures" as PTN
  rectangle "**User**\ncomptes, profil" as USR
}

rectangle "**RabbitMQ**\nfile « notifications »" as RMQ #E3F2FD
rectangle "**Notification**\nPython / FastAPI" as NOT #E3F2FD
rectangle "**Mailtrap**\nSMTP / API" as MAIL #F5F5F5

package "PostgreSQL" as DBS #FDEBD2 {
  database "srv_db" as SRVDB
  database "marketplace_db" as MKTDB
  database "delivery_db" as DELDB
  database "event_db" as EVTDB
  database "partnership_db" as PTNDB
}

' --- accès utilisateur
Client -down-> FE : HTTPS
FE -right-> KC : connexion (token)
FE -down-> GW : REST + JWT
GW .right.> KC : clés publiques (JWK)
GW -down-> MS : routage lb://
GW .left.> EU : découverte
MS .up.> EU : enregistrement

' --- appels synchrones (OpenFeign)
MKT <-right-> DEL : Feign
PTN -left-> EVT : Feign
USR .up.> KC : création des comptes\n(API admin)

' --- persistance
SRV -down-> SRVDB
MKT -down-> MKTDB
DEL -down-> DELDB
EVT -down-> EVTDB
PTN -down-> PTNDB

' --- asynchrone
MS -right-> RMQ : publication\n(réservations, événements,\nlivraisons...)
RMQ -down-> NOT : consommation
NOT -down-> MAIL : email

legend right
  —— synchrone (HTTP / JDBC)
  - - - découverte / sécurité
endlegend

@enduml
