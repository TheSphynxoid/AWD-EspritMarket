{
  "info": {
    "_postman_id": "marketplace-product-crud",
    "name": "Marketplace - Product CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Lenovo\",\n  \"description\": \"Laptop professionnel\",\n  \"price\": 2499.99,\n  \"stock\": 10,\n  \"category\": \"Informatique\",\n  \"color\": \"Gris\"\n}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Get product by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Lenovo Updated\",\n  \"description\": \"Laptop professionnel mis a jour\",\n  \"price\": 2299.99,\n  \"stock\": 8,\n  \"category\": \"Informatique\",\n  \"color\": \"Noir\"\n}"
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    }
  ]
}
