            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ma boutique mise a jour\",\n  \"description\": \"Nouvelle description\",\n  \"logoUrl\": \"https://example.com/new-logo.png\",\n  \"ownerId\": 1,\n  \"ownerEmail\": \"wajdi@esprit.tn\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
