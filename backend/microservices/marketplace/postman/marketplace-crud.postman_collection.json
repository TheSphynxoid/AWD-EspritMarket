              }
            ],
            "url": "{{baseUrl}}/mic2/paniers/{{userId}}/items/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/mic2/paniers/{{userId}}/items/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear panier",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/mic2/paniers/{{userId}}"
