    {
      "name": "5. Delivery sync (Marketplace -> Delivery via Feign)",
      "item": [
        {
          "name": "1. Create delivery sync",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/mic2/deliveries/sync",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientName\": \"Ahmed Ben Ali\",\n  \"address\": \"12 rue de la Liberte\",\n  \"city\": \"Tunis\",\n  \"postalCode\": \"1000\",\n  \"phone\": \"+21612345678\",\n  \"deliveryFee\": 5.0,\n  \"deliveryType\": \"STANDARD\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('status PENDING', function () { pm.expect(pm.response.json().status).to.eql('PENDING'); });",
                  "pm.collectionVariables.set('deliveryId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. PREUVE - Delivery direct (port 8084)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{deliveryUrl}}/api/deliveries"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get delivery sync",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/mic2/deliveries/sync/{{deliveryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. List deliveries sync",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/mic2/deliveries/sync"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Update status sync (IN_PROGRESS)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/mic2/deliveries/sync/{{deliveryId}}/status?status=IN_PROGRESS"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('status IN_PROGRESS', function () { pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. PREUVE - Delivery direct par id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{deliveryUrl}}/api/deliveries/{{deliveryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
