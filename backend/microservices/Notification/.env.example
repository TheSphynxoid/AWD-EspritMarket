# Lancement local (python app.py) : copier en .env dans ce dossier (ignoré par git).
# En Docker, utiliser deploy/.env à la place.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EUREKA_URL=http://localhost:8761/eureka

# Mailtrap (prioritaire sur SMTP). Sandbox de test : renseigner MAILTRAP_INBOX_ID.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM=
MAILTRAP_FROM_NAME=EspritMarket
